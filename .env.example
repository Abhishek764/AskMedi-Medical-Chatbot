# Copy to .env for local development
FLASK_ENV=development

# Flask session signing key (generate a random value for production)
SECRET_KEY=change-me

# Local default is sqlite; on Render this is injected from the database.
# DATABASE_URL=postgresql://user:pass@host:5432/askmedi

# Required API keys
PINECONE_API_KEY=your-pinecone-key
OPENAI_API_KEY=your-openai-key

# Optional overrides
PINECONE_INDEX=medical-chatbot
OPENAI_MODEL=gpt-4o
CHAT_HISTORY_TURNS=6
MAX_MESSAGE_LEN=2000
