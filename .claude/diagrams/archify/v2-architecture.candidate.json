  "cards": [
    { "dot": "rose", "title": "Safety", "items": [
      "Input guard runs before retrieval: crisis or emergency stops the answer and returns fixed helpline copy",
      "A crisis turn marks the conversation elevated (sticky) in PostgreSQL",
      "Abstain gate refuses when rerank score is below threshold; verifier drops uncited, unsupported or invented-number sentences"
    ] },
    { "dot": "emerald", "title": "Free by default", "items": [
      "Embeddings and rerank: fastembed local ONNX; BM25 is computed in-process",
      "Generator: extractive (verbatim source sentences); Ollama, OpenAI or Claude by env var",
      "Qdrant runs embedded locally or as Qdrant Cloud"
    ] },
    { "dot": "cyan", "title": "Data", "items": [
      "Licence allowlist enforced by the ingestor; openFDA overdosage sections excluded",
      "Ingestor also records each document in the PostgreSQL registry",
      "Worker jobs are queued in Redis (arq)"
    ] },
    { "dot": "slate", "title": "Ops", "items": [
      "GitHub Actions: ruff, pytest, Alembic upgrade and drift check",
      "Sentry is optional (SENTRY_DSN) and strips bodies and auth headers",
      "Render blueprint: API, worker, PostgreSQL, Key Value"
    ] }
  ]
