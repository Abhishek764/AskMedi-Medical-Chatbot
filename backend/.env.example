# AskMedi backend configuration. Copy to .env. Every value has a free default.
ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./askmedi.db
# REDIS_URL=redis://localhost:6379/0          # required in staging/prod
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DB_AUTO_CREATE=true                           # false in staging/prod (use alembic upgrade head)

# Retrieval (free local models; `uv sync --extra local`)
EMBEDDINGS_PROVIDER=fastembed                 # hash | fastembed | openai
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DIM=384
RERANK_PROVIDER=fastembed                     # none | fastembed | cohere
QDRANT_COLLECTION=corpus-v1
QDRANT_PATH=./qdrant_data                     # embedded mode; set QDRANT_URL for a server
# QDRANT_URL=https://xxx.cloud.qdrant.io
# QDRANT_API_KEY=
RAW_DATA_DIR=./data/raw

# Generation
LLM_PROVIDER=extractive                       # extractive | ollama | openai | anthropic
# LLM_MODEL=llama3.1:8b                       # for ollama (free, local)
# OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=

CRISIS_COUNTRY=IN
