# AskMedi backend configuration. Copy to .env and fill in what you have.
# Every value has a free default: with no keys at all the app runs on local models and
# extractive answers. Put real keys ONLY in .env (gitignored), never in this file.

# --- App ---------------------------------------------------------------------------
ENV=dev                                       # dev | test | staging | prod
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=["http://localhost:5173"]        # JSON list of web origins allowed to call the API
TRUST_CLOUDFLARE_IP_HEADER=false              # true only when every request comes through Cloudflare
CRISIS_COUNTRY=IN                             # helplines shown in crisis cards (IN | US | GB)

# --- Storage -----------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./askmedi.db # prod: postgresql+asyncpg://user:pass@host/db
DB_AUTO_CREATE=true                           # false in staging/prod (run alembic upgrade head)
# REDIS_URL=redis://localhost:6379/0          # required in staging/prod; empty = in-memory

# --- Retrieval (free local models; needs `uv sync --extra local`) -------------------
EMBEDDINGS_PROVIDER=fastembed                 # hash | fastembed | openai
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DIM=384
RERANK_PROVIDER=fastembed                     # none | fastembed | cohere
QDRANT_COLLECTION=corpus-v1
QDRANT_PATH=./qdrant_data                     # embedded mode (one process at a time)
# QDRANT_URL=https://xxx.cloud.qdrant.io      # set for Qdrant Cloud / a server
# QDRANT_API_KEY=
RAW_DATA_DIR=../data/raw                      # downloads cache (gitignored)
POLICIES_DIR=../data/policies                 # parsed insurance policies (demo)

# --- Answer writer (LLM) ------------------------------------------------------------
# auto = first provider with a key, in this order: OpenAI, Gemini, Claude (the others become
# fallbacks). No key = extractive (copies source sentences). If every model fails, answers
# fall back to extractive automatically.
LLM_PROVIDER=auto                             # auto | extractive | gemini | openai | anthropic | ollama
LLM_TIMEOUT_SECONDS=30

# Gemini: free key from https://aistudio.google.com/apikey (free-tier prompts may be used by
# Google to improve its products: test with sample questions, not real patients' messages)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI: paste when you have credit; it becomes primary automatically, Gemini its fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Ollama (optional, free, runs on your machine): set LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Cohere reranker (optional): set RERANK_PROVIDER=cohere
COHERE_API_KEY=

# --- Limits ------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
DAILY_QUESTION_QUOTA=50
MAX_QUESTION_CHARS=1000

# --- Observability (optional) --------------------------------------------------------
SENTRY_DSN=
